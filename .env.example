# Contoh konfigurasi Environment Variables SILANG MAN 1 Jepara
DJANGO_SECRET_KEY=ganti-dengan-secret-key-acak-yang-panjang-dan-aman
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.onrender.com,silang-man1jepara.onrender.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://silang-man1jepara.onrender.com,https://*.onrender.com

# Koneksi Database Cloud (Neon / Supabase / PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password_anda@ep-cool-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Keamanan SSL (True untuk production)
SECURE_SSL_REDIRECT=True
